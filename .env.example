# Copy to .env and fill in. Keys stay on the server; never expose them to the browser.

# Ethereum — https://dashboard.alchemy.com (free tier is enough to start)
ALCHEMY_API_KEY=

# Solana — https://dashboard.helius.dev (free tier is enough to start)
HELIUS_API_KEY=
# Optional overrides if Helius changes hostnames
# HELIUS_API_BASE=https://api.helius.xyz/v0
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Bitcoin — public mempool.space needs no key. Self-host for heavy traffic.
MEMPOOL_BASE_URL=https://mempool.space/api

# .sol name lookup (optional override)
# SNS_RESOLVER_URL=https://sns-sdk-proxy.bonfida.workers.dev

# Prices — https://www.coingecko.com/en/api. Demo keys see ~1 year of history;
# all-time history needs a paid plan (set COINGECKO_PLAN=pro).
COINGECKO_API_KEY=
COINGECKO_PLAN=demo

# Frontend origin(s) allowed to call the API
CORS_ORIGINS=http://localhost:3000
SCANS_PER_HOUR=10

# Frontend
API_URL=http://localhost:8000   # website server forwards /api/* here

# NFT floor prices. Solana floors use Magic Eden's public API (no key needed);
# Ethereum floors reuse ALCHEMY_API_KEY. Both optional.
MAGICEDEN_API_URL=https://api-mainnet.magiceden.dev/v2
MAGICEDEN_API_KEY=
