# Copy to .env and fill in. Keys stay on the server; never expose them to the browser.

# Ethereum — https://dashboard.alchemy.com (free tier is enough to start)
ALCHEMY_API_KEY=

# Solana — https://dashboard.helius.dev (free tier is enough to start)
HELIUS_API_KEY=
# Optional overrides if Helius changes hostnames
# HELIUS_API_BASE=https://api.helius.xyz/v0
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Bitcoin — public mempool.space needs no key. Self-host for heavy traffic.
MEMPOOL_BASE_URL=https://mempool.space/api

# .sol name lookup (optional override)
# SNS_RESOLVER_URL=https://sns-sdk-proxy.bonfida.workers.dev

# Prices — https://www.coingecko.com/en/api. Demo keys see ~1 year of history;
# all-time history needs a paid plan (set COINGECKO_PLAN=pro).
COINGECKO_API_KEY=
COINGECKO_PLAN=demo

# Frontend origin(s) allowed to call the API
CORS_ORIGINS=http://localhost:3000
SCANS_PER_HOUR=10

# Frontend
API_URL=http://localhost:8000   # website server forwards /api/* here

# NFT floor prices. Solana floors use Magic Eden's public API (no key needed);
# Ethereum floors reuse ALCHEMY_API_KEY. Both optional.
MAGICEDEN_API_URL=https://api-mainnet.magiceden.dev/v2
MAGICEDEN_API_KEY=

# Optional shared price cache (Render Key Value / any Redis). Keeps CoinGecko
# data across server restarts and scans. Internal URL looks like redis://red-xxxx:6379
CACHE_URL=

# Cardano via Koios. Works with no key (public tier: 5,000 requests/day shared
# by the server). A free account at koios.rest raises that to 50,000/day.
KOIOS_API_KEY=
KOIOS_API_URL=https://api.koios.rest/api/v1

# XRP Ledger public JSON-RPC server (no key). Alternative: https://s1.ripple.com:51234
XRPL_RPC_URL=https://xrplcluster.com

# NFT floors for Cardano (OpenCNFT) and XRP (XRP Ledger Services). No keys.
OPENCNFT_API_URL=https://api.opencnft.io/1
XRPLDATA_API_URL=https://api.xrpldata.com/api/v1

# Dogecoin. Main source: electrs-dogecoin explorer (no key). Backup: BlockCypher;
# a free BlockCypher token raises its limit from about 100 requests an hour.
DOGE_ESPLORA_URL=https://doge-electrs-demo.qed.me
BLOCKCYPHER_API_URL=https://api.blockcypher.com/v1/doge/main
BLOCKCYPHER_TOKEN=

# Doginals (Dogecoin NFTs) via Maestro's Dogecoin inscription API. Free account:
# gomaestro.org. Without a key, Doginals are skipped.
MAESTRO_API_KEY=
MAESTRO_DOGE_URL=https://doge-mainnet.gomaestro-api.org/v0
DOGINALS_CONTENT_URL=https://wonky-ord.dogeord.io/content/{id}

# --- API for apps -----------------------------------------------------------
# Browser origins (other websites) allowed to call the API directly; "*" = any.
CORS_ORIGINS=http://localhost:3000
# Partner apps: "name:key,name2:key2", sent as X-API-Key for higher limits.
API_CLIENT_KEYS=
# Same random value on BOTH services: lets the backend trust the visitor IPs
# the website's proxy passes along (for per-person rate limits).
PROXY_SHARED_SECRET=
# Admin panel password (backend only, 16+ characters). Panel at /admin; off when unset.
ADMIN_TOKEN=
# Rate limits (per person or key)
RATE_REQUESTS_PER_MIN=240
RATE_SCANS_PER_HOUR=12
RATE_RESOLVES_PER_MIN=30
RATE_PARTNER_MULTIPLIER=20
