{
  "compilerOptions": {
    "target": "ES2020", "lib": ["dom", "dom.iterable", "es2020"], "strict": true,
    "module": "esnext", "moduleResolution": "bundler", "jsx": "preserve",
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true, "incremental": true,
    "resolveJsonModule": true, "isolatedModules": true, "allowJs": false,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
